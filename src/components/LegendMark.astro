---
interface Props {
	tone: 'pink' | 'fire';
}

const { tone } = Astro.props;

const fill = tone === 'fire' ? '#F8C08A' : '#F7B6C8';
const mid = tone === 'fire' ? '#F4A261' : '#EE7AA3';
const deep = tone === 'fire' ? '#E0893A' : '#E84C89';
const line = '#5A3840';
---

<span class="relative mx-auto mb-1.5 grid size-[3rem] place-items-center overflow-hidden rounded-full" aria-hidden="true">
	<span class="absolute inset-0 rounded-full bg-[#fbf3ea] ring-2 ring-pink/55"></span>
	<span class="absolute inset-[4px] rounded-full border border-dashed border-[#e8a0b8]"></span>

	{
		tone === 'pink' ? (
			<svg class="relative size-[1.85rem]" viewBox="0 0 64 64" fill="none">
				<g transform="rotate(-8 32 32)">
					<circle cx="32" cy="32" r="16.8" fill={fill} stroke={line} stroke-width="2.1" />
					<circle cx="32" cy="32" r="11.6" fill={deep} />
					<path
						d="M25.6 32.6 31.2 38 41.2 26.6"
						stroke="white"
						stroke-width="3.4"
						stroke-linecap="round"
						stroke-linejoin="round"
					/>
				</g>
				<path
					d="M39.6 43.4c0-2.3 1.6-3.8 3.6-3.8 1 0 1.9.5 2.5 1.3.6-.8 1.5-1.3 2.5-1.3 2 0 3.6 1.5 3.6 3.8 0 3.9-6.1 7-6.1 7S39.6 47.3 39.6 43.4Z"
					fill={deep}
					stroke={line}
					stroke-width="1.45"
				/>
			</svg>
		) : (
			<svg class="relative size-[1.85rem]" viewBox="0 0 64 64" fill="none">
				<path
					d="M32 11.2c2 4.2 3.8 8.2 3.4 12.4-.2 2.1-1.1 3.9-2.4 5.2 1.9-.5 3.8-2.1 4.8-4.2 1.4 3 1.6 6.2.5 9.2-1.2 3.5-4.1 5.9-7.7 6.6 4.7-.2 8.8-3.3 10-7.6 1-3.6.2-7.3-2-10 2 3.5 3.1 6.4 3.1 9.3 0 6.4-5 11.6-10.9 11.6S19.9 38.5 19.9 32.1c0-5.9 3.7-10.6 7.6-13.4-.2 2.4.6 5 2.4 6.6C28.6 19.8 30.1 14.8 32 11.2Z"
					fill={fill}
					stroke={line}
					stroke-width="2"
					stroke-linejoin="round"
				/>
				<path
					d="M31.4 28.8c1.5 2.1 2 4 1.5 6.1-.5 2.4-2.2 4-4.5 4.5 2.2 0 4.3-1.7 5-4 .6-1.9 0-3.8-1.2-5.3-.1.8.3 1.7.7 2.4"
					fill={mid}
					stroke={line}
					stroke-width="1.5"
					stroke-linecap="round"
					stroke-linejoin="round"
				/>
				<path
					d="M39.4 43.8c0-2.3 1.6-3.8 3.6-3.8 1 0 1.9.5 2.5 1.3.6-.8 1.5-1.3 2.5-1.3 2 0 3.6 1.5 3.6 3.8 0 3.9-6.1 7-6.1 7S39.4 47.7 39.4 43.8Z"
					fill={deep}
					stroke={line}
					stroke-width="1.45"
				/>
			</svg>
		)
	}
</span>
