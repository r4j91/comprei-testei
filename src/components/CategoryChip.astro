---
import CategoryIcon from './CategoryIcon.astro';

interface Category {
	id: string;
	title: string;
}

interface Props {
	category: Category;
}

const { category } = Astro.props;
---

<li class="flex min-w-0 flex-col items-center gap-1.5 text-center">
	<CategoryIcon id={category.id} compact />
	<p class="whitespace-nowrap text-[0.72rem] font-extrabold leading-tight text-ink">{category.title}</p>
</li>
