---
import Icon from './Icon.astro';
import CategoryIcon from './CategoryIcon.astro';

interface Category {
	id: string;
	title: string;
	description: string;
	whatsappUrl: string;
}

interface Props {
	category: Category;
}

const { category } = Astro.props;
---

<a
	href={category.whatsappUrl}
	target="_blank"
	rel="noopener noreferrer"
	class="invite group flex min-h-16 items-center gap-3 rounded-2xl bg-white px-3 py-3 sm:gap-3.5 sm:px-3.5"
>
	<CategoryIcon id={category.id} />

	<span class="min-w-0 flex-1">
		<span class="block text-[0.98rem] font-extrabold leading-tight text-ink">{category.title}</span>
		<span class="mt-0.5 block text-[0.875rem] leading-snug text-muted">{category.description}</span>
	</span>

	<span
		class="wa-seal grid size-11 shrink-0 place-items-center rounded-xl bg-gradient-to-br from-pink to-pink-deep text-white sm:size-12"
		aria-hidden="true"
	>
		<Icon name="whatsapp" class="size-5" />
	</span>
	<span class="sr-only">Entrar no grupo {category.title} no WhatsApp</span>
</a>
