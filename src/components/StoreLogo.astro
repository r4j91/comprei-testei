---
interface Props {
	id: string;
	class?: string;
}

const { id, class: className = 'h-6 w-auto max-w-[110px]' } = Astro.props;

const logos: Record<string, { src: string; alt: string; width: number; height: number }> = {
	amazon: {
		src: '/assets/stores/amazon.svg',
		alt: 'Amazon',
		width: 120,
		height: 36,
	},
	shopee: {
		src: '/assets/stores/shopee.svg',
		alt: 'Shopee',
		width: 120,
		height: 38,
	},
	'mercado-livre': {
		src: '/assets/stores/mercado-livre.svg',
		alt: 'Mercado Livre',
		width: 120,
		height: 48,
	},
	'tiktok-shop': {
		src: '/assets/stores/tiktok-shop.svg',
		alt: 'TikTok Shop',
		width: 130,
		height: 64,
	},
};

const logo = logos[id];
---

{
	logo && (
		<img
			src={logo.src}
			alt={logo.alt}
			width={logo.width}
			height={logo.height}
			class:list={['object-contain object-center', className]}
			decoding="async"
		/>
	)
}
