---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import Logo from '../components/Logo.astro';
import Sparkle from '../components/Sparkle.astro';
import StoreLogo from '../components/StoreLogo.astro';
import GroupInvite from '../components/GroupInvite.astro';
import CategoryChip from '../components/CategoryChip.astro';
import LegendMark from '../components/LegendMark.astro';
import data from '../data/links.json';

const { brand, group, categories, categoriesTitle, stores, legend } = data;
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta
			name="description"
			content="Comprei Testei — achadinhos que valem o seu dinheiro. Entre no grupo gratuito de WhatsApp."
		/>
		<meta name="theme-color" content="#fff5f7" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Itim&family=Nunito:wght@500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<title>{brand.name} — achadinhos que valem o seu dinheiro</title>
	</head>
	<body class="min-h-dvh">
		<div
			class="pointer-events-none fixed inset-0 -z-10 bg-[radial-gradient(ellipse_at_top,#ffe4ec_0%,#fff5f7_42%,#fffaf8_100%)]"
		>
		</div>
		<div
			class="pointer-events-none fixed inset-x-0 top-0 -z-10 h-[28rem] bg-[radial-gradient(ellipse_at_80%_0%,rgba(245,185,66,0.14),transparent_46%)]"
		>
		</div>

		<main class="relative mx-auto w-full max-w-[430px] px-4 pb-6 pt-3 sm:px-5 lg:max-w-[760px] lg:pb-8 lg:pt-5">
			<header class="relative flex flex-col items-center text-center">
				<Sparkle class="absolute left-6 top-2 size-3 text-gold sm:left-10" />
				<Sparkle class="absolute right-8 top-12 size-2.5 text-pink/80 sm:right-16" />

				<Logo class="max-w-[148px] sm:max-w-[168px]" />

				<p
					class="mt-2 inline-flex items-center rounded-full border border-pink/25 bg-cream px-3.5 py-1 font-script text-[1.02rem] leading-none text-ink/80"
				>
					{brand.tagline}
				</p>

				<h1
					class="mt-3 max-w-[18ch] text-[1.32rem] font-extrabold leading-tight tracking-[-0.02em] text-ink sm:text-[1.5rem]"
				>
					{brand.headline}
				</h1>
				<p class="mt-1.5 max-w-[34ch] text-[0.9rem] font-semibold leading-snug text-muted">
					{brand.subheadline}
				</p>
			</header>

			<div class="mt-4 grid items-start gap-4 lg:mt-5 lg:grid-cols-2 lg:gap-5">
				<GroupInvite group={group} />

				<div class="flex flex-col gap-3.5">
					<section aria-labelledby="stores-title">
						<h2 id="stores-title" class="text-center text-[0.92rem] font-bold text-ink lg:text-left">
							Prefere procurar as ofertas por loja?
						</h2>
						<div class="mt-2.5 grid grid-cols-2 gap-2 sm:grid-cols-4 lg:grid-cols-2">
							{
								stores.map((store) => (
									<a
										href={store.url}
										target="_blank"
										rel="noopener noreferrer"
										class="flex h-12 items-center justify-center rounded-2xl bg-white px-1.5 shadow-[0_3px_8px_rgba(232,76,137,0.1)] transition-[background-color,box-shadow] duration-200 hover:bg-[#fffafc] hover:shadow-[0_4px_8px_rgba(232,76,137,0.16)]"
									>
										{/* TikTok's logo is 2:1 with stacked text, so it needs more height to read at the same size */}
									<StoreLogo
										id={store.id}
										class:list={[
											'w-auto max-w-[86px] object-contain object-center',
											store.id === 'tiktok-shop' ? 'h-10' : 'h-7',
										]}
									/>
										<span class="sr-only">{store.name}</span>
									</a>
								))
							}
						</div>
					</section>

					<section aria-labelledby="categories-title">
						<h2 id="categories-title" class="text-center text-[0.92rem] font-extrabold text-ink lg:text-left">
							{categoriesTitle}
						</h2>
						<ul class="mt-2.5 grid grid-cols-5 gap-x-1">
							{categories.map((category) => <CategoryChip category={category} />)}
						</ul>
					</section>

					<section
						class="rounded-2xl border border-dashed border-pink/45 bg-blush-soft/80 px-3 py-3 sm:px-3.5"
						aria-labelledby="legend-title"
					>
						<h2 id="legend-title" class="text-center text-[0.92rem] font-extrabold text-ink">
							{legend.title}
						</h2>
						<div class="mt-2 grid grid-cols-2 gap-2.5">
							{
								legend.items.map((item) => (
									<div class="text-center">
										<LegendMark tone={item.tone === 'fire' ? 'fire' : 'pink'} />
										<p class="text-[0.7rem] font-extrabold tracking-wide text-ink">{item.label}</p>
										<p class="mt-0.5 text-[0.8rem] leading-snug text-muted">{item.text}</p>
									</div>
								))
							}
						</div>
					</section>
				</div>
			</div>

			<section class="mt-3.5 flex flex-col gap-2 sm:flex-row" aria-label="Redes e site">
				<a
					href={brand.instagramUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="flex min-h-12 flex-1 items-center gap-3 rounded-2xl bg-gradient-to-r from-pink-hot via-pink to-pink-deep px-4 py-2.5 text-white transition-[filter] duration-200 hover:brightness-105"
				>
					<span class="grid size-8 place-items-center rounded-full bg-white/15">
						<Icon name="instagram" class="size-4" />
					</span>
					<span class="flex-1 text-left text-[0.85rem] font-bold leading-snug">
						{brand.instagramLabel}
					</span>
					<Icon name="arrow" class="size-4 opacity-90" />
				</a>

				<a
					href={brand.websiteUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="flex min-h-12 flex-1 items-center gap-3 rounded-2xl bg-cream-btn px-4 py-2.5 text-ink transition-[background-color] duration-200 hover:bg-cream"
				>
					<span class="grid size-8 place-items-center rounded-full bg-white/70 text-pink-deep">
						<Icon name="globe" class="size-4" />
					</span>
					<span class="flex-1 text-left text-[0.85rem] font-bold leading-snug">
						{brand.websiteLabel}
					</span>
					<Icon name="arrow" class="size-4 text-ink/70" />
				</a>
			</section>

			<footer class="relative mt-5 px-2 text-center">
				<Sparkle class="absolute left-1 top-0 size-3 text-pink/70" />
				<Sparkle class="absolute right-2 bottom-2 size-3 text-gold" />
				<p class="font-script text-[1.22rem] leading-snug text-pink-deep sm:text-[1.32rem]">
					{brand.catchphrase}
				</p>
				<p class="mt-2 font-script text-[1.02rem] leading-snug text-pink-deep/90">
					<span aria-hidden="true">♥ </span>
					{brand.footer}
				</p>
				<p class="mt-2 text-[0.72rem] font-semibold text-muted/80">
					{brand.copyright}
				</p>
			</footer>
		</main>
	</body>
</html>
