---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import Logo from '../components/Logo.astro';
import StoreLogo from '../components/StoreLogo.astro';
import CategoryCard from '../components/CategoryCard.astro';
import data from '../data/links.json';

const { brand, categories, stores, legend } = data;
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta
			name="description"
			content="Comprei Testei — ofertas boas, de amiga para amiga. Entre nos grupos de WhatsApp por categoria."
		/>
		<meta name="theme-color" content="#fff5f7" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600;700&family=Nunito:wght@500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<title>{brand.name} — grupos de ofertas</title>
	</head>
	<body class="min-h-dvh">
		<div
			class="pointer-events-none fixed inset-0 -z-10 bg-[radial-gradient(ellipse_at_top,#ffe4ec_0%,#fff5f7_45%,#fffaf8_100%)]"
		>
		</div>

		<main class="mx-auto w-full max-w-[430px] px-4 pb-10 pt-5 sm:px-5">
			<header class="flex flex-col items-center text-center">
				<Logo />

				<p
					class="mt-3 inline-flex items-center rounded-full border border-pink/20 bg-cream px-4 py-1 font-script text-[1.15rem] leading-none text-ink/80"
				>
					{brand.tagline}
				</p>

				<h1 class="mt-5 max-w-[20ch] text-balance text-[1.35rem] font-extrabold leading-tight text-ink sm:text-[1.45rem]">
					{brand.headline}
				</h1>
				<p class="mt-2 text-[0.95rem] font-semibold text-muted">
					{brand.subheadline}
				</p>
			</header>

			<section class="mt-5 flex flex-col gap-2.5" aria-label="Grupos por categoria">
				{categories.map((category) => <CategoryCard category={category} />)}
			</section>

			<section
				class="mt-6 rounded-2xl border border-dashed border-pink/45 bg-blush-soft/80 px-3.5 py-4"
				aria-labelledby="legend-title"
			>
				<h2 id="legend-title" class="text-center text-[0.95rem] font-extrabold text-ink">
					{legend.title}
				</h2>
				<div class="mt-3 grid grid-cols-2 gap-3">
					{
						legend.items.map((item) => (
							<div class="text-center">
								<span
									class:list={[
										'mx-auto mb-2 grid size-9 place-items-center rounded-full text-white',
										item.tone === 'fire' ? 'bg-fire' : 'bg-pink',
									]}
								>
									{item.tone === 'fire' ? (
										<Icon name="fire" class="size-4" />
									) : (
										<Icon name="check" class="size-4" />
									)}
								</span>
								<p class="text-[0.68rem] font-extrabold tracking-wide text-ink">{item.label}</p>
								<p class="mt-1 text-[0.7rem] leading-snug text-muted">{item.text}</p>
							</div>
						))
					}
				</div>
			</section>

			<section class="mt-6" aria-labelledby="stores-title">
				<h2 id="stores-title" class="text-center text-[0.95rem] font-bold text-ink">
					Prefere procurar as ofertas por loja?
				</h2>
				<div class="mt-3 grid grid-cols-4 gap-1.5">
					{
						stores.map((store) => (
							<a
								href={store.url}
								target="_blank"
								rel="noopener noreferrer"
								class="flex h-14 items-center justify-center rounded-2xl border border-pink/15 bg-white px-1.5 transition hover:border-pink/35 hover:bg-[#fffbfc] motion-safe:hover:-translate-y-0.5"
							>
								<StoreLogo id={store.id} class="h-8 w-auto max-w-[86px] object-contain object-center" />
								<span class="sr-only">{store.name}</span>
							</a>
						))
					}
				</div>
			</section>

			<section class="mt-5 flex flex-col gap-2.5" aria-label="Redes e site">
				<a
					href={brand.instagramUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="flex items-center gap-3 rounded-2xl bg-gradient-to-r from-pink-hot via-pink-deep to-[#d946a0] px-4 py-3.5 text-white transition hover:brightness-105"
				>
					<span class="grid size-9 place-items-center rounded-full bg-white/15">
						<Icon name="instagram" class="size-5" />
					</span>
					<span class="flex-1 text-left text-[0.88rem] font-bold leading-snug">
						{brand.instagramLabel}
					</span>
					<Icon name="arrow" class="size-5 opacity-90" />
				</a>

				<a
					href={brand.websiteUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="flex items-center gap-3 rounded-2xl border border-black/5 bg-cream-btn px-4 py-3.5 text-ink transition hover:bg-cream"
				>
					<span class="grid size-9 place-items-center rounded-full bg-white/70 text-pink-deep">
						<Icon name="globe" class="size-5" />
					</span>
					<span class="flex-1 text-left text-[0.88rem] font-bold leading-snug">
						{brand.websiteLabel}
					</span>
					<Icon name="arrow" class="size-5 text-ink/70" />
				</a>
			</section>

			<footer class="mt-7 px-2 text-center">
				<p class="relative font-script text-[1.25rem] leading-snug text-pink-deep">
					<span class="absolute -left-1 -top-1 text-[0.9rem]" aria-hidden="true">✦</span>
					<span aria-hidden="true">♥ </span>
					{brand.footer}
					<span aria-hidden="true"> ✨</span>
					<span class="absolute -bottom-1 -right-1 text-[0.9rem] text-pink/70" aria-hidden="true">✦</span>
				</p>
			</footer>
		</main>
	</body>
</html>
